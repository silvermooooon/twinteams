digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"agent_approvals" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_approvals</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, approval_id</FONT></TD></TR></TABLE>>, URL="#table-agent_approvals", tooltip="独立操作审批"];
"agent_commands" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_commands</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, command_id</FONT></TD></TR></TABLE>>, URL="#table-agent_commands", tooltip="可靠输入命令"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"agent_session_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, seq</FONT></TD></TR></TABLE>>, URL="#table-agent_session_events", tooltip="会话执行日志"];
"agent_tool_operations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_tool_operations</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, operation_id</FONT></TD></TR></TABLE>>, URL="#table-agent_tool_operations", tooltip="工具副作用操作账本"];
"approval_contexts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">approval_contexts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, approval_id</FONT></TD></TR></TABLE>>, URL="#table-approval_contexts", tooltip="审批的产品上下文"];
"approval_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">approval_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, approval_event_id</FONT></TD></TR></TABLE>>, URL="#table-approval_events", tooltip="审批不可变事件"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">messages</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-messages", tooltip="聊天消息"];
"notifications" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">notifications</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-notifications", tooltip="Owner 通知"];
"operation_attempts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">operation_attempts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, operation_id, attempt_no</FONT></TD></TR></TABLE>>, URL="#table-operation_attempts", tooltip="工具网络尝试"];
"owners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owners</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-owners", tooltip="真人帐号"];
"twins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">twins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-twins", tooltip="Twin 配对"];
"agent_tool_operations" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R033", taillabel="0..N", headlabel="1", URL="#rel-R033", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_tool_operations" -> "agent_tool_operations" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R034", taillabel="0..N", headlabel="0..1", URL="#rel-R034", tooltip="(tenant_id, parent_operation_id) → agent_tool_operations(tenant_id, operation_id)"];
"agent_tool_operations" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R035", taillabel="0..N", headlabel="1", URL="#rel-R035", tooltip="(tenant_id, command_id) → agent_commands(tenant_id, command_id)"];
"agent_tool_operations" -> "agent_approvals" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R036", taillabel="0..N", headlabel="0..1", URL="#rel-R036", tooltip="(tenant_id, approval_id) → agent_approvals(tenant_id, approval_id)"];
"agent_tool_operations" -> "agent_session_events" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R037", taillabel="0..N", headlabel="0..1", URL="#rel-R037", tooltip="(tenant_id, session_id, tool_returned_event_ref) → agent_session_events(tenant_id, session_id, event_id)"];
"agent_tool_operations" -> "agent_session_events" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R038", taillabel="0..N", headlabel="0..1", URL="#rel-R038", tooltip="(tenant_id, session_id, tool_completed_event_ref) → agent_session_events(tenant_id, session_id, event_id)"];
"operation_attempts" -> "agent_tool_operations" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R039", taillabel="0..N", headlabel="1", URL="#rel-R039", tooltip="(tenant_id, operation_id) → agent_tool_operations(tenant_id, operation_id)"];
"agent_approvals" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R029", taillabel="0..N", headlabel="1", URL="#rel-R029", tooltip="(tenant_id, requesting_session_id, requesting_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_approvals" -> "agent_tool_operations" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R030", taillabel="0..N", headlabel="1", URL="#rel-R030", tooltip="(tenant_id, operation_id) → agent_tool_operations(tenant_id, operation_id)"];
"agent_approvals" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R031", taillabel="0..N", headlabel="0..1", URL="#rel-R031", tooltip="(tenant_id, continuation_command_id) → agent_commands(tenant_id, command_id)"];
"approval_events" -> "agent_approvals" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R032", taillabel="0..N", headlabel="1", URL="#rel-R032", tooltip="(tenant_id, approval_id) → agent_approvals(tenant_id, approval_id)"];
"approval_contexts" -> "agent_approvals" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R096", taillabel="0..1", headlabel="1", URL="#rel-R096", tooltip="(tenant_id, approval_id) → agent_approvals(tenant_id, approval_id)"];
"approval_contexts" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R097", taillabel="0..N", headlabel="1", URL="#rel-R097", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"approval_contexts" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R098", taillabel="0..N", headlabel="1", URL="#rel-R098", tooltip="(tenant_id, twin_id) → twins(tenant_id, actor_id)"];
"approval_contexts" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R099", taillabel="0..N", headlabel="1", URL="#rel-R099", tooltip="(tenant_id, owner_id) → owners(tenant_id, actor_id)"];
"approval_contexts" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R100", taillabel="0..N", headlabel="0..1", URL="#rel-R100", tooltip="(tenant_id, chat_id, source_message_id) → messages(tenant_id, chat_id, id)"];
"notifications" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R149", taillabel="0..N", headlabel="1", URL="#rel-R149", tooltip="(tenant_id, recipient_owner_id) → owners(tenant_id, actor_id)"];
"notifications" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R150", taillabel="0..N", headlabel="1", URL="#rel-R150", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"notifications" -> "approval_contexts" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R151", taillabel="0..N", headlabel="0..1", URL="#rel-R151", tooltip="(tenant_id, approval_id) → approval_contexts(tenant_id, approval_id)"];
}