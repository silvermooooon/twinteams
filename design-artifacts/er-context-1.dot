digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"agent_model_usage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_model_usage</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, attempt_id</FONT></TD></TR></TABLE>>, URL="#table-agent_model_usage", tooltip="模型调用用量"];
"chat_memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chat_memberships</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chat_memberships", tooltip="配对成员记录"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"context_manifests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">context_manifests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-context_manifests", tooltip="上下文来源清单"];
"context_sources" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">context_sources</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, manifest_id, ordinal</FONT></TD></TR></TABLE>>, URL="#table-context_sources", tooltip="上下文来源明细"];
"file_versions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">file_versions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-file_versions", tooltip="文件不可变版本"];
"history_grants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">history_grants</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-history_grants", tooltip="历史阅读授权"];
"message_revisions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">message_revisions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, message_id, revision</FONT></TD></TR></TABLE>>, URL="#table-message_revisions", tooltip="消息正文版本"];
"messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">messages</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-messages", tooltip="聊天消息"];
"summaries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">summaries</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-summaries", tooltip="授权摘要"];
"summary_segments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">summary_segments</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, summary_id, ordinal</FONT></TD></TR></TABLE>>, URL="#table-summary_segments", tooltip="摘要精确片段"];
"tracking_entries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">tracking_entries</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-tracking_entries", tooltip="Tracking 动态"];
"twins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">twins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-twins", tooltip="Twin 配对"];
"context_manifests" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R102", taillabel="0..N", headlabel="1", URL="#rel-R102", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"context_manifests" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R103", taillabel="0..N", headlabel="1", URL="#rel-R103", tooltip="(tenant_id, consumer_twin_id) → twins(tenant_id, actor_id)"];
"context_manifests" -> "chat_memberships" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R104", taillabel="0..N", headlabel="1", URL="#rel-R104", tooltip="(tenant_id, membership_id) → chat_memberships(tenant_id, id)"];
"context_manifests" -> "history_grants" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R105", taillabel="0..N", headlabel="1", URL="#rel-R105", tooltip="(tenant_id, membership_id, grant_version) → history_grants(tenant_id, membership_id, policy_version)"];
"context_sources" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R106", taillabel="0..N", headlabel="1", URL="#rel-R106", tooltip="(tenant_id, manifest_id) → context_manifests(tenant_id, id)"];
"context_sources" -> "history_grants" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R107", taillabel="0..N", headlabel="1", URL="#rel-R107", tooltip="(tenant_id, grant_id) → history_grants(tenant_id, id)"];
"context_sources" -> "message_revisions" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R108", taillabel="0..N", headlabel="1", URL="#rel-R108", tooltip="(tenant_id, source_id, source_revision) → message_revisions(tenant_id, message_id, revision)"];
"context_sources" -> "file_versions" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R109", taillabel="0..N", headlabel="1", URL="#rel-R109", tooltip="(tenant_id, source_id, source_revision) → file_versions(tenant_id, id, version_no)"];
"context_sources" -> "tracking_entries" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R110", taillabel="0..N", headlabel="1", URL="#rel-R110", tooltip="(tenant_id, source_id, source_revision) → tracking_entries(tenant_id, id, revision)"];
"context_sources" -> "summaries" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R111", taillabel="0..N", headlabel="1", URL="#rel-R111", tooltip="(tenant_id, source_id, source_revision) → summaries(tenant_id, id, version)"];
"summaries" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R112", taillabel="0..N", headlabel="1", URL="#rel-R112", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"summaries" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R113", taillabel="0..N", headlabel="1", URL="#rel-R113", tooltip="(tenant_id, coverage_manifest_id) → context_manifests(tenant_id, id)"];
"summaries" -> "agent_model_usage" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R114", taillabel="0..N", headlabel="1", URL="#rel-R114", tooltip="(tenant_id, model_attempt_id) → agent_model_usage(tenant_id, attempt_id)"];
"summary_segments" -> "summaries" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R115", taillabel="0..N", headlabel="1", URL="#rel-R115", tooltip="(tenant_id, summary_id) → summaries(tenant_id, id)"];
"summary_segments" -> "summaries" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R116", taillabel="0..N", headlabel="0..1", URL="#rel-R116", tooltip="(tenant_id, included_summary_id) → summaries(tenant_id, id)"];
"summary_segments" -> "messages" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R117", taillabel="0..N", headlabel="0..N", URL="#rel-R117", tooltip="(tenant_id, summary_id, source_start, source_end) → messages(tenant_id, chat_id, seq)"];
}