digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"agent_model_usage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_model_usage</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, attempt_id</FONT></TD></TR></TABLE>>, URL="#table-agent_model_usage", tooltip="模型调用用量"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"context_manifests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">context_manifests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-context_manifests", tooltip="上下文来源清单"];
"messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">messages</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-messages", tooltip="聊天消息"];
"owners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owners</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-owners", tooltip="真人帐号"];
"presence_leases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">presence_leases</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, owner_id, device_id<BR ALIGN="LEFT"/>auth_session_ref</FONT></TD></TR></TABLE>>, URL="#table-presence_leases", tooltip="在线查看租约"];
"reply_intents" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_intents</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_intents", tooltip="逻辑回复意图"];
"reply_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_requests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_requests", tooltip="已接受回复请求"];
"routing_decisions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">routing_decisions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-routing_decisions", tooltip="目标路由决定"];
"routing_targets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8062ad" BGCOLOR="#f1eafb"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#8062ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">routing_targets</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, decision_id, owner_actor_id</FONT></TD></TR></TABLE>>, URL="#table-routing_targets", tooltip="目标路由成员明细（可选）"];
"trigger_candidates" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">trigger_candidates</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-trigger_candidates", tooltip="预触发候选"];
"twins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">twins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-twins", tooltip="Twin 配对"];
"presence_leases" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R147", taillabel="0..N", headlabel="1", URL="#rel-R147", tooltip="(tenant_id, owner_id) → owners(tenant_id, actor_id)"];
"presence_leases" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R148", taillabel="0..N", headlabel="0..1", URL="#rel-R148", tooltip="(tenant_id, focused_chat_id) → chats(tenant_id, id)"];
"routing_decisions" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R065", taillabel="0..N", headlabel="1", URL="#rel-R065", tooltip="(tenant_id, message_id) → messages(tenant_id, id)"];
"routing_decisions" -> "agent_model_usage" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R066", taillabel="0..N", headlabel="0..1", URL="#rel-R066", tooltip="(tenant_id, model_attempt_id) → agent_model_usage(tenant_id, attempt_id)"];
"routing_decisions" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R067", taillabel="0..N", headlabel="0..1", URL="#rel-R067", tooltip="(tenant_id, context_manifest_id) → context_manifests(tenant_id, id)"];
"routing_targets" -> "routing_decisions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R068", taillabel="0..N", headlabel="1", URL="#rel-R068", tooltip="(tenant_id, decision_id) → routing_decisions(tenant_id, id)"];
"routing_targets" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R069", taillabel="0..N", headlabel="1", URL="#rel-R069", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
"trigger_candidates" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R070", taillabel="0..N", headlabel="1", URL="#rel-R070", tooltip="(tenant_id, message_id) → messages(tenant_id, id)"];
"trigger_candidates" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R071", taillabel="0..N", headlabel="1", URL="#rel-R071", tooltip="(tenant_id, target_twin_id) → twins(tenant_id, actor_id)"];
"trigger_candidates" -> "routing_decisions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R072", taillabel="0..N", headlabel="1", URL="#rel-R072", tooltip="(tenant_id, decision_id) → routing_decisions(tenant_id, id)"];
"trigger_candidates" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R073", taillabel="0..N", headlabel="0..1", URL="#rel-R073", tooltip="(tenant_id, accepted_request_id) → reply_requests(tenant_id, id)"];
"reply_intents" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R074", taillabel="0..N", headlabel="1", URL="#rel-R074", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"reply_intents" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R075", taillabel="0..N", headlabel="1", URL="#rel-R075", tooltip="(tenant_id, chat_id, source_message_id) → messages(tenant_id, chat_id, id)"];
"reply_intents" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R076", taillabel="0..N", headlabel="1", URL="#rel-R076", tooltip="(tenant_id, target_twin_id) → twins(tenant_id, actor_id)"];
"reply_intents" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R077", taillabel="0..1", headlabel="0..1", URL="#rel-R077", tooltip="(tenant_id, request_id) → reply_requests(tenant_id, id)"];
}