digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">actors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-actors", tooltip="统一身份"];
"agent_commands" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_commands</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, command_id</FONT></TD></TR></TABLE>>, URL="#table-agent_commands", tooltip="可靠输入命令"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"agent_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id</FONT></TD></TR></TABLE>>, URL="#table-agent_sessions", tooltip="执行会话"];
"chat_twin_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chat_twin_sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chat_twin_sessions", tooltip="聊天与执行会话映射"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"reply_attempts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_attempts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_attempts", tooltip="请求执行尝试"];
"reply_intents" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_intents</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_intents", tooltip="逻辑回复意图"];
"reply_lanes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_lanes</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, chat_id, twin_id</FONT></TD></TR></TABLE>>, URL="#table-reply_lanes", tooltip="聊天与 Twin 的主回复通道"];
"reply_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_requests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_requests", tooltip="已接受回复请求"];
"twins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">twins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-twins", tooltip="Twin 配对"];
"reply_requests" -> "reply_intents" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R078", taillabel="0..1", headlabel="1", URL="#rel-R078", tooltip="(tenant_id, intent_id) → reply_intents(tenant_id, id)"];
"reply_requests" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R079", taillabel="0..N", headlabel="1", URL="#rel-R079", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"reply_requests" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R080", taillabel="0..N", headlabel="1", URL="#rel-R080", tooltip="(tenant_id, target_twin_id) → twins(tenant_id, actor_id)"];
"reply_requests" -> "reply_lanes" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R081", taillabel="0..N", headlabel="1", URL="#rel-R081", tooltip="(tenant_id, chat_id, target_twin_id) → reply_lanes(tenant_id, chat_id, twin_id)"];
"reply_requests" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R082", taillabel="0..N", headlabel="0..1", URL="#rel-R082", tooltip="(tenant_id, requester_actor_id) → actors(tenant_id, id)"];
"reply_requests" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R083", taillabel="0..N", headlabel="1", URL="#rel-R083", tooltip="(tenant_id, source_sender_actor_id) → actors(tenant_id, id)"];
"reply_requests" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R084", taillabel="0..N", headlabel="0..1", URL="#rel-R084", tooltip="(tenant_id, cancelled_by) → actors(tenant_id, id)"];
"reply_requests" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R085", taillabel="0..N", headlabel="0..1", URL="#rel-R085", tooltip="(tenant_id, retry_of_request_id) → reply_requests(tenant_id, id)"];
"reply_requests" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R086", taillabel="0..N", headlabel="0..1", URL="#rel-R086", tooltip="(tenant_id, input_command_id) → agent_commands(tenant_id, command_id)"];
"reply_lanes" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R087", taillabel="0..N", headlabel="1", URL="#rel-R087", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"reply_lanes" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R088", taillabel="0..N", headlabel="1", URL="#rel-R088", tooltip="(tenant_id, twin_id) → twins(tenant_id, actor_id)"];
"reply_lanes" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R089", taillabel="0..1", headlabel="0..1", URL="#rel-R089", tooltip="(tenant_id, active_request_id) → reply_requests(tenant_id, id)"];
"reply_attempts" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R090", taillabel="0..N", headlabel="1", URL="#rel-R090", tooltip="(tenant_id, request_id) → reply_requests(tenant_id, id)"];
"reply_attempts" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R091", taillabel="0..N", headlabel="1", URL="#rel-R091", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"reply_attempts" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R092", taillabel="0..N", headlabel="0..1", URL="#rel-R092", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"chat_twin_sessions" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R093", taillabel="0..N", headlabel="1", URL="#rel-R093", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"chat_twin_sessions" -> "twins" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R094", taillabel="0..N", headlabel="1", URL="#rel-R094", tooltip="(tenant_id, twin_id) → twins(tenant_id, actor_id)"];
"chat_twin_sessions" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R095", taillabel="0..1", headlabel="1", URL="#rel-R095", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
}