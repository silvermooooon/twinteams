digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">actors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-actors", tooltip="统一身份"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"context_manifests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">context_manifests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-context_manifests", tooltip="上下文来源清单"];
"file_versions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">file_versions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-file_versions", tooltip="文件不可变版本"];
"owner_chat_settings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owner_chat_settings</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, owner_id, chat_id</FONT></TD></TR></TABLE>>, URL="#table-owner_chat_settings", tooltip="Owner 单聊设置"];
"owner_settings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owner_settings</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, owner_id</FONT></TD></TR></TABLE>>, URL="#table-owner_settings", tooltip="Owner 全局设置"];
"owners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owners</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-owners", tooltip="真人帐号"];
"workspace_grants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">workspace_grants</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-workspace_grants", tooltip="工作空间授权"];
"workspace_nodes" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">workspace_nodes</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-workspace_nodes", tooltip="工作空间节点"];
"workspaces" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">workspaces</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-workspaces", tooltip="聊天工作空间"];
"workspaces" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R130", taillabel="0..1", headlabel="1", URL="#rel-R130", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"workspace_nodes" -> "workspaces" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R131", taillabel="0..N", headlabel="1", URL="#rel-R131", tooltip="(tenant_id, workspace_id) → workspaces(tenant_id, id)"];
"workspace_nodes" -> "workspace_nodes" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R132", taillabel="0..N", headlabel="0..1", URL="#rel-R132", tooltip="(tenant_id, workspace_id, parent_id) → workspace_nodes(tenant_id, workspace_id, id)"];
"workspace_nodes" -> "file_versions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R133", taillabel="0..N", headlabel="0..1", URL="#rel-R133", tooltip="(tenant_id, id, current_version_id) → file_versions(tenant_id, node_id, id)"];
"file_versions" -> "workspace_nodes" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R134", taillabel="0..N", headlabel="1", URL="#rel-R134", tooltip="(tenant_id, node_id) → workspace_nodes(tenant_id, id)"];
"file_versions" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R135", taillabel="0..N", headlabel="1", URL="#rel-R135", tooltip="(tenant_id, created_by) → actors(tenant_id, id)"];
"file_versions" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R136", taillabel="0..N", headlabel="0..1", URL="#rel-R136", tooltip="(tenant_id, source_manifest_id) → context_manifests(tenant_id, id)"];
"workspace_grants" -> "workspaces" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R137", taillabel="0..N", headlabel="1", URL="#rel-R137", tooltip="(tenant_id, workspace_id) → workspaces(tenant_id, id)"];
"workspace_grants" -> "workspace_nodes" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R138", taillabel="0..N", headlabel="0..1", URL="#rel-R138", tooltip="(tenant_id, workspace_id, node_id) → workspace_nodes(tenant_id, workspace_id, id)"];
"workspace_grants" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R139", taillabel="0..N", headlabel="1", URL="#rel-R139", tooltip="(tenant_id, principal_id) → actors(tenant_id, id)"];
"owner_settings" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R140", taillabel="0..1", headlabel="1", URL="#rel-R140", tooltip="(tenant_id, owner_id) → owners(tenant_id, actor_id)"];
"owner_chat_settings" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R141", taillabel="0..N", headlabel="1", URL="#rel-R141", tooltip="(tenant_id, owner_id) → owners(tenant_id, actor_id)"];
"owner_chat_settings" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R142", taillabel="0..N", headlabel="1", URL="#rel-R142", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
}