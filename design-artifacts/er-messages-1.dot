digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">actors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-actors", tooltip="统一身份"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"agent_session_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, seq</FONT></TD></TR></TABLE>>, URL="#table-agent_session_events", tooltip="会话执行日志"];
"agent_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id</FONT></TD></TR></TABLE>>, URL="#table-agent_sessions", tooltip="执行会话"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"human_read_receipts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">human_read_receipts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, message_id, owner_actor_id</FONT></TD></TR></TABLE>>, URL="#table-human_read_receipts", tooltip="真人逐消息已读"];
"message_origins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">message_origins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, message_id</FONT></TD></TR></TABLE>>, URL="#table-message_origins", tooltip="消息生成来源"];
"message_revisions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">message_revisions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, message_id, revision</FONT></TD></TR></TABLE>>, URL="#table-message_revisions", tooltip="消息正文版本"];
"messages" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">messages</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-messages", tooltip="聊天消息"];
"owners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owners</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-owners", tooltip="真人帐号"];
"reply_attempts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_attempts</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_attempts", tooltip="请求执行尝试"];
"reply_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_requests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_requests", tooltip="已接受回复请求"];
"view_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">view_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-view_events", tooltip="会话查看事件"];
"messages" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R047", taillabel="0..N", headlabel="1", URL="#rel-R047", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"messages" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R048", taillabel="0..N", headlabel="1", URL="#rel-R048", tooltip="(tenant_id, author_actor_id) → actors(tenant_id, id)"];
"messages" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R049", taillabel="0..N", headlabel="0..1", URL="#rel-R049", tooltip="(tenant_id, chat_id, reply_to_message_id) → messages(tenant_id, chat_id, id)"];
"messages" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R050", taillabel="0..N", headlabel="0..1", URL="#rel-R050", tooltip="(tenant_id, source_request_id) → reply_requests(tenant_id, id)"];
"messages" -> "message_revisions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R051", taillabel="0..1", headlabel="1", URL="#rel-R051", tooltip="(tenant_id, id, current_revision) → message_revisions(tenant_id, message_id, revision)"];
"message_revisions" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R052", taillabel="0..N", headlabel="1", URL="#rel-R052", tooltip="(tenant_id, message_id) → messages(tenant_id, id)"];
"message_revisions" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R053", taillabel="0..N", headlabel="0..1", URL="#rel-R053", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
"message_revisions" -> "agent_session_events" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R054", taillabel="0..N", headlabel="0..1", URL="#rel-R054", tooltip="(tenant_id, source_session_id, source_event_id) → agent_session_events(tenant_id, session_id, event_id)"];
"message_origins" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R055", taillabel="0..1", headlabel="1", URL="#rel-R055", tooltip="(tenant_id, message_id) → messages(tenant_id, id)"];
"message_origins" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R056", taillabel="0..N", headlabel="0..1", URL="#rel-R056", tooltip="(tenant_id, request_id) → reply_requests(tenant_id, id)"];
"message_origins" -> "reply_attempts" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R057", taillabel="0..N", headlabel="0..1", URL="#rel-R057", tooltip="(tenant_id, attempt_id) → reply_attempts(tenant_id, id)"];
"message_origins" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R058", taillabel="0..N", headlabel="0..1", URL="#rel-R058", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"message_origins" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R059", taillabel="0..N", headlabel="0..1", URL="#rel-R059", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"message_origins" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R060", taillabel="0..N", headlabel="0..1", URL="#rel-R060", tooltip="(tenant_id, acting_for_owner_id) → owners(tenant_id, actor_id)"];
"human_read_receipts" -> "messages" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R061", taillabel="0..N", headlabel="1", URL="#rel-R061", tooltip="(tenant_id, message_id) → messages(tenant_id, id)"];
"human_read_receipts" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R062", taillabel="0..N", headlabel="1", URL="#rel-R062", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
"view_events" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R063", taillabel="0..N", headlabel="1", URL="#rel-R063", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"view_events" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R064", taillabel="0..N", headlabel="1", URL="#rel-R064", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
}