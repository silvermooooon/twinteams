digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">actors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-actors", tooltip="统一身份"];
"agent_commands" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_commands</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, command_id</FONT></TD></TR></TABLE>>, URL="#table-agent_commands", tooltip="可靠输入命令"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"context_manifests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">context_manifests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-context_manifests", tooltip="上下文来源清单"];
"reply_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">twinteams · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">reply_requests</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-reply_requests", tooltip="已接受回复请求"];
"run_origins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8062ad" BGCOLOR="#f1eafb"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#8062ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">run_origins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-run_origins", tooltip="Run 来源投影（可选）"];
"tracking_entries" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">tracking_entries</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-tracking_entries", tooltip="Tracking 动态"];
"tracking_tombstones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">tracking_tombstones</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, topic_id</FONT></TD></TR></TABLE>>, URL="#table-tracking_tombstones", tooltip="Tracking 删除保护"];
"tracking_topic_revisions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">tracking_topic_revisions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, topic_id, revision</FONT></TD></TR></TABLE>>, URL="#table-tracking_topic_revisions", tooltip="Tracking 目录修订"];
"tracking_topics" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">tracking_topics</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-tracking_topics", tooltip="Tracking 主题"];
"tracking_topics" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R118", taillabel="0..N", headlabel="1", URL="#rel-R118", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"tracking_topics" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R119", taillabel="0..N", headlabel="1", URL="#rel-R119", tooltip="(tenant_id, created_by_actor) → actors(tenant_id, id)"];
"tracking_topics" -> "tracking_topic_revisions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R120", taillabel="0..N", headlabel="1", URL="#rel-R120", tooltip="(tenant_id, id, current_revision) → tracking_topic_revisions(tenant_id, topic_id, revision)"];
"tracking_topic_revisions" -> "tracking_topics" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R121", taillabel="0..N", headlabel="1", URL="#rel-R121", tooltip="(tenant_id, topic_id) → tracking_topics(tenant_id, id)"];
"tracking_topic_revisions" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R122", taillabel="0..N", headlabel="1", URL="#rel-R122", tooltip="(tenant_id, source_manifest_id) → context_manifests(tenant_id, id)"];
"tracking_topic_revisions" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R123", taillabel="0..N", headlabel="1", URL="#rel-R123", tooltip="(tenant_id, created_by) → actors(tenant_id, id)"];
"tracking_entries" -> "tracking_topics" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R124", taillabel="0..N", headlabel="1", URL="#rel-R124", tooltip="(tenant_id, topic_id) → tracking_topics(tenant_id, id)"];
"tracking_entries" -> "context_manifests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R125", taillabel="0..N", headlabel="1", URL="#rel-R125", tooltip="(tenant_id, source_manifest_id) → context_manifests(tenant_id, id)"];
"tracking_entries" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R126", taillabel="0..N", headlabel="1", URL="#rel-R126", tooltip="(tenant_id, created_by) → actors(tenant_id, id)"];
"tracking_tombstones" -> "tracking_topics" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R127", taillabel="0..N", headlabel="1", URL="#rel-R127", tooltip="(tenant_id, chat_id, topic_id) → tracking_topics(tenant_id, chat_id, id)"];
"tracking_tombstones" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R128", taillabel="0..N", headlabel="1", URL="#rel-R128", tooltip="(tenant_id, deleted_by) → actors(tenant_id, id)"];
"tracking_tombstones" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R129", taillabel="0..N", headlabel="0..1", URL="#rel-R129", tooltip="(tenant_id, reopen_command_id) → agent_commands(tenant_id, command_id)"];
"run_origins" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R143", taillabel="0..1", headlabel="1", URL="#rel-R143", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"run_origins" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R144", taillabel="0..N", headlabel="1", URL="#rel-R144", tooltip="(tenant_id, origin_chat_id) → chats(tenant_id, id)"];
"run_origins" -> "reply_requests" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R145", taillabel="0..N", headlabel="1", URL="#rel-R145", tooltip="(tenant_id, root_request_id) → reply_requests(tenant_id, id)"];
"run_origins" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R146", taillabel="0..N", headlabel="0..1", URL="#rel-R146", tooltip="(tenant_id, parent_session_id, parent_run_id) → agent_runs(tenant_id, session_id, run_id)"];
}