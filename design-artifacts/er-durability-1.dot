digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"agent_commands" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_commands</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, command_id</FONT></TD></TR></TABLE>>, URL="#table-agent_commands", tooltip="可靠输入命令"];
"agent_inbox" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_inbox</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, receiver_session_id<BR ALIGN="LEFT"/>message_key</FONT></TD></TR></TABLE>>, URL="#table-agent_inbox", tooltip="可靠收件箱"];
"agent_outbox" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_outbox</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, outbox_id</FONT></TD></TR></TABLE>>, URL="#table-agent_outbox", tooltip="可靠发件箱"];
"agent_run_edges" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_run_edges</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, child_session_id<BR ALIGN="LEFT"/>child_run_id, edge_kind</FONT></TD></TR></TABLE>>, URL="#table-agent_run_edges", tooltip="明确父子运行边"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"agent_session_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, seq</FONT></TD></TR></TABLE>>, URL="#table-agent_session_events", tooltip="会话执行日志"];
"agent_session_leases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9c6b25" BGCOLOR="#fff0dc"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9c6b25">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_leases</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id</FONT></TD></TR></TABLE>>, URL="#table-agent_session_leases", tooltip="会话租约与隔离栅栏"];
"agent_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id</FONT></TD></TR></TABLE>>, URL="#table-agent_sessions", tooltip="执行会话"];
"agent_stream_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#8062ad" BGCOLOR="#f1eafb"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#8062ad">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_stream_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, stream_seq</FONT></TD></TR></TABLE>>, URL="#table-agent_stream_events", tooltip="可选全粒度事件流"];
"agent_tool_operations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#9ba6b6" BGCOLOR="#f4f6fa"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#9ba6b6">RT · 引用</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_tool_operations</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, operation_id</FONT></TD></TR></TABLE>>, URL="#table-agent_tool_operations", tooltip="工具副作用操作账本"];
"agent_session_leases" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R010", taillabel="0..1", headlabel="1", URL="#rel-R010", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_commands" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R018", taillabel="0..N", headlabel="1", URL="#rel-R018", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_commands" -> "agent_session_events" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R019", taillabel="0..N", headlabel="0..1", URL="#rel-R019", tooltip="(tenant_id, session_id, applied_journal_seq) → agent_session_events(tenant_id, session_id, seq)"];
"agent_commands" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R020", taillabel="0..N", headlabel="0..1", URL="#rel-R020", tooltip="(tenant_id, session_id, applied_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_outbox" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R021", taillabel="0..N", headlabel="0..1", URL="#rel-R021", tooltip="(tenant_id, source_session_id) → agent_sessions(tenant_id, session_id)"];
"agent_outbox" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R022", taillabel="0..N", headlabel="0..1", URL="#rel-R022", tooltip="(tenant_id, source_session_id, source_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_inbox" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R023", taillabel="0..N", headlabel="1", URL="#rel-R023", tooltip="(tenant_id, receiver_session_id) → agent_sessions(tenant_id, session_id)"];
"agent_inbox" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R024", taillabel="0..N", headlabel="0..1", URL="#rel-R024", tooltip="(tenant_id, sender_session_id) → agent_sessions(tenant_id, session_id)"];
"agent_inbox" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R025", taillabel="0..N", headlabel="0..1", URL="#rel-R025", tooltip="(tenant_id, sender_session_id, sender_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_inbox" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R026", taillabel="0..N", headlabel="0..1", URL="#rel-R026", tooltip="(tenant_id, consumed_command_id) → agent_commands(tenant_id, command_id)"];
"agent_run_edges" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R027", taillabel="0..N", headlabel="1", URL="#rel-R027", tooltip="(tenant_id, child_session_id, child_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_run_edges" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R028", taillabel="0..N", headlabel="1", URL="#rel-R028", tooltip="(tenant_id, parent_session_id, parent_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_stream_events" -> "agent_sessions" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R011", taillabel="0..N", headlabel="1", URL="#rel-R011", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_stream_events" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R012", taillabel="0..N", headlabel="0..1", URL="#rel-R012", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_stream_events" -> "agent_session_events" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R013", taillabel="0..N", headlabel="0..1", URL="#rel-R013", tooltip="(tenant_id, session_id, journal_seq) → agent_session_events(tenant_id, session_id, seq)"];
"agent_stream_events" -> "agent_commands" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R014", taillabel="0..N", headlabel="0..1", URL="#rel-R014", tooltip="(tenant_id, command_id) → agent_commands(tenant_id, command_id)"];
"agent_stream_events" -> "agent_tool_operations" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R015", taillabel="0..N", headlabel="0..1", URL="#rel-R015", tooltip="(tenant_id, parent_operation_id) → agent_tool_operations(tenant_id, operation_id)"];
"agent_stream_events" -> "agent_runs" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R016", taillabel="0..N", headlabel="0..1", URL="#rel-R016", tooltip="(tenant_id, originating_session_id, originating_run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_stream_events" -> "agent_stream_events" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R017", taillabel="0..N", headlabel="0..1", URL="#rel-R017", tooltip="(tenant_id, session_id, causation_event_id) → agent_stream_events(tenant_id, session_id, event_id)"];
}