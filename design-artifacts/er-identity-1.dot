digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"actors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">actors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-actors", tooltip="统一身份"];
"chat_memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chat_memberships</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chat_memberships", tooltip="配对成员记录"];
"chats" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">chats</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-chats", tooltip="聊天会话"];
"history_grants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">history_grants</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, id</FONT></TD></TR></TABLE>>, URL="#table-history_grants", tooltip="历史阅读授权"];
"owners" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">owners</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-owners", tooltip="真人帐号"];
"twins" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#4c65ad" BGCOLOR="#e9efff"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#4c65ad">twinteams</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">twins</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, actor_id</FONT></TD></TR></TABLE>>, URL="#table-twins", tooltip="Twin 配对"];
"owners" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R040", taillabel="0..1", headlabel="1", URL="#rel-R040", tooltip="(tenant_id, actor_id) → actors(tenant_id, id)"];
"twins" -> "actors" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R041", taillabel="0..1", headlabel="1", URL="#rel-R041", tooltip="(tenant_id, actor_id) → actors(tenant_id, id)"];
"twins" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R042", taillabel="0..1", headlabel="1", URL="#rel-R042", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
"chats" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R043", taillabel="0..N", headlabel="0..1", URL="#rel-R043", tooltip="(tenant_id, private_owner_id) → owners(tenant_id, actor_id)"];
"chat_memberships" -> "chats" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R044", taillabel="0..N", headlabel="1", URL="#rel-R044", tooltip="(tenant_id, chat_id) → chats(tenant_id, id)"];
"chat_memberships" -> "owners" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R045", taillabel="0..N", headlabel="1", URL="#rel-R045", tooltip="(tenant_id, owner_actor_id) → owners(tenant_id, actor_id)"];
"history_grants" -> "chat_memberships" [style=dashed, color="#5a71ac", fontcolor="#5a71ac", label="R046", taillabel="0..N", headlabel="1", URL="#rel-R046", tooltip="(tenant_id, membership_id) → chat_memberships(tenant_id, id)"];
}