digraph ER {
graph [rankdir=LR, bgcolor="transparent", pad="0.35", nodesep="0.32", ranksep="1.1", splines=polyline, outputorder=edgesfirst];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=10, color="#7d8a9c", arrowsize=0.65, labeldistance=1.8, labelfloat=false];
"agent_audit_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_audit_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, audit_id</FONT></TD></TR></TABLE>>, URL="#table-agent_audit_events", tooltip="安全审计事件"];
"agent_model_usage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_model_usage</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, attempt_id</FONT></TD></TR></TABLE>>, URL="#table-agent_model_usage", tooltip="模型调用用量"];
"agent_runs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_runs</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, run_id</FONT></TD></TR></TABLE>>, URL="#table-agent_runs", tooltip="运行投影"];
"agent_session_archives" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_archives</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, start_seq</FONT></TD></TR></TABLE>>, URL="#table-agent_session_archives", tooltip="日志归档分段"];
"agent_session_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_session_events</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id, seq</FONT></TD></TR></TABLE>>, URL="#table-agent_session_events", tooltip="会话执行日志"];
"agent_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8" COLOR="#2b765c" BGCOLOR="#e6f4ee"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#2b765c">RT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B><FONT POINT-SIZE="14">agent_sessions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="11" COLOR="#435067">PK tenant_id, session_id</FONT></TD></TR></TABLE>>, URL="#table-agent_sessions", tooltip="执行会话"];
"agent_session_events" -> "agent_sessions" [style=solid, color="#26765a", fontcolor="#26765a", label="R001", taillabel="0..N", headlabel="1", URL="#rel-R001", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_session_archives" -> "agent_sessions" [style=solid, color="#26765a", fontcolor="#26765a", label="R002", taillabel="0..N", headlabel="1", URL="#rel-R002", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_runs" -> "agent_sessions" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R003", taillabel="0..N", headlabel="1", URL="#rel-R003", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_audit_events" -> "agent_sessions" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R004", taillabel="0..N", headlabel="0..1", URL="#rel-R004", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_audit_events" -> "agent_runs" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R005", taillabel="0..N", headlabel="0..1", URL="#rel-R005", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
"agent_model_usage" -> "agent_sessions" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R006", taillabel="0..N", headlabel="1", URL="#rel-R006", tooltip="(tenant_id, session_id) → agent_sessions(tenant_id, session_id)"];
"agent_model_usage" -> "agent_runs" [style=dotted, color="#9273a7", fontcolor="#9273a7", label="R007", taillabel="0..N", headlabel="0..1", URL="#rel-R007", tooltip="(tenant_id, session_id, run_id) → agent_runs(tenant_id, session_id, run_id)"];
}