# LOCAL ONLY. Copy to a private ignored .env and load explicitly before launch.
TWINTEAMS_ENV=local
TWINTEAMS_DEVELOPMENT_MODE=true
TWINTEAMS_TENANT_ID=local
# Required. Local development and deployment both use PostgreSQL.
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/appdb
# Same database for the SDK journal and coordination tables.
AGENT_DB_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:5432/appdb

# Real model configuration. Use a model available to your account.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6-luna
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Deployment identity. DEV-* login is disabled outside local mode.
# TWINTEAMS_ENV=production
# TWINTEAMS_DEVELOPMENT_MODE=false
# TWINTEAMS_JWT_ALGORITHM=RS256
# TWINTEAMS_JWT_KEY=server-side-verification-key
# TWINTEAMS_JWT_ISSUER=https://your-issuer.example
# TWINTEAMS_JWT_AUDIENCE=twinteams

# Persistent paths, outside public web roots. Production private SDK memory is
# enabled only when AGENT_MEMORY_DIR is explicitly configured.
# TWINTEAMS_WORKSPACE_ROOT=/persistent/twinteams/workspaces
# AGENT_MEMORY_DIR=/persistent/twinteams/runtime-memory

# Server-owned checkpoints, shared by private/group replies and routing.
# Token estimates are primary; count also bounds tiny rows. Failure preserves
# prior state and fails this attempt before incomplete history reaches a model.
# TWINTEAMS_SUMMARY_AFTER_TOKENS=24000
# TWINTEAMS_SUMMARY_KEEP_TOKENS=8000
# TWINTEAMS_SUMMARY_MAX_TOKENS=2000
# TWINTEAMS_SUMMARY_AFTER_MESSAGES=40
# TWINTEAMS_SUMMARY_KEEP_MESSAGES=20

# Automatic Duet replies share a fixed six-acceptance budget per causal chain.
# Explicit human Continue adds six more; accepted runs are never stopped.

# Redis is ephemeral presence and notification transport; PG remains authoritative.
TWINTEAMS_REDIS_URL=redis://127.0.0.1:6379/0
TWINTEAMS_REDIS_PREFIX=twinteams:local
TWINTEAMS_COMPENSATION_SECONDS=60
TWINTEAMS_MAX_RUNNING=8
TWINTEAMS_MAX_PER_OWNER=2
# Independent per-worker background limits; physical DB/provider/CPU remain shared.
TWINTEAMS_MAX_BACKGROUND_RUNNING=2
TWINTEAMS_MAX_BACKGROUND_PER_OWNER=1
TWINTEAMS_MAX_BACKGROUND_CHILDREN=2
TWINTEAMS_ROUTING_CONCURRENCY=2
# Start one execution service with: python -m app.worker
# API replicas must not be used as execution workers.

# Optional owner credential storage. Supply one persistent host-only Fernet key.
# Keep this key and encrypted files outside Twin workspaces; missing key leaves credentials unconfigured.
AGENT_SECRETS_KEY=
# AGENT_SECRETS_DIR=/absolute/host-only/credential-directory

# Incremental private-memory consolidation; first new experience schedules in 4h.
TWINTEAMS_MEMORY_DREAM_INTERVAL_SECONDS=14400

# Durable personal schedules: Redis is a disposable due index, PostgreSQL is authoritative.
TWINTEAMS_SCHEDULED_TASK_MIN_INTERVAL_SECONDS=60
TWINTEAMS_SCHEDULED_TASK_MAX_PER_OWNER=100
TWINTEAMS_SCHEDULED_TASK_BATCH_SIZE=100
TWINTEAMS_SCHEDULED_TASK_RECONCILE_SECONDS=300

# A single persisted first meeting for a new empty owner-private conversation.
TWINTEAMS_ONBOARDING_ENABLED=true
